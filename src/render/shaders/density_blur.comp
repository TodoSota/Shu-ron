#version 430 core

//==============================================================================
// density_blur.comp : 密度格子の 1 次元ガウスぼかし (Splat モード S2)
// 目的: 密度をぼかして、密度勾配から求める法線の滑らかさを調整する。
//       x → y → z の 3 回に分けてかける (分離可能なので 3 次元のガウスぼかしと同じ結果になる)。
//       ぼかしの標準偏差 sigma が、法線の滑らかさを決める唯一の値になる。
//       格子の外は 0 (空) として扱う。
//==============================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

uniform sampler3D src;
layout(r32f, binding = 0) writeonly uniform image3D dst;

uniform int gridN;
uniform ivec3 direction;	// (1,0,0), (0,1,0), (0,0,1) のいずれか
uniform float sigma;		// 標準偏差 [セル] (> 0)

const int kMaxRadius = 8;

void main() {
	ivec3 c = ivec3(gl_GlobalInvocationID);
	if (any(greaterThanEqual(c, ivec3(gridN)))) return;

	int radius = min(int(ceil(2.0 * sigma)), kMaxRadius);
	float sum = 0.0, wsum = 0.0;
	for (int i = -radius; i <= radius; ++i) {
		float w = exp(-float(i * i) / (2.0 * sigma * sigma));
		wsum += w;	// 格子の外 (0) も重みの和には含める: 境界で密度が下がり、外が空であることが残る
		ivec3 q = c + direction * i;
		if (any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, ivec3(gridN)))) continue;
		sum += w * texelFetch(src, q, 0).r;
	}
	imageStore(dst, c, vec4(sum / wsum, 0.0, 0.0, 0.0));
}
