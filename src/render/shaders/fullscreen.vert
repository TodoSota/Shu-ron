#version 430 core

//==============================================================================
// fullscreen.vert : 画面全体を覆う三角形 1 枚 (全画面パス共通)
// 目的: 頂点バッファを使わずに、gl_VertexID (0, 1, 2) から画面を覆う大きな三角形を作る。
//       glDrawArrays(GL_TRIANGLES, 0, 3) で、空の VAO を束縛して描く。
//==============================================================================

out vec2 v_uv;	// 画面上の位置 [0, 1]²

void main() {
	vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);	// (0,0), (2,0), (0,2)
	v_uv = p;
	gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
