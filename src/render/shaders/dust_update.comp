#version 430 core

//==============================================================================
// dust_update.comp : 粉塵を動かし、寿命を減らす
// 目的: 粉塵は空気に強く引きずられる細かい粒なので、速度を
//         目標の速度 (ゆっくり沈む + 乱流のような揺らぎ) へ指数的に近づける
//       という単純なモデルで動かす。
//         v ← v_target + (v - v_target) · e^(-drag·dt)
//       揺らぎは、ベクトルポテンシャルの回転 (curl noise, Bridson et al. 2007) で作るので、
//       発散がなく、粉塵が一か所に集まったり消えたりしない。
// 並列化: 1 スレッド = 粉塵 1 個。
//==============================================================================

layout(local_size_x = 64) in;

struct Dust { vec4 posAge; vec4 velLife; };
layout(std430, binding = 2) buffer DustBuffer { Dust dust[]; };

uniform float dt;
uniform float time;
uniform float drag;			// [1/s]
uniform float sinkSpeed;	// [m/s]
uniform float turbulence;	// [m/s]
uniform vec3 floorNormal;
uniform float floorHeight;

// ベクトルポテンシャル (周波数の異なる正弦波の和。時間でゆっくり動かす)
vec3 potential(vec3 p) {
	const float f1 = 7.0, f2 = 13.0;
	return vec3(sin(f1 * p.y + 0.9 * time) + 0.5 * sin(f2 * p.z - 1.7 * time),
	            sin(f1 * p.z + 1.1 * time) + 0.5 * sin(f2 * p.x + 1.3 * time),
	            sin(f1 * p.x + 0.7 * time) + 0.5 * sin(f2 * p.y - 1.1 * time)) / 7.0;
}

// ポテンシャルの回転 (中心差分)
vec3 curlNoise(vec3 p) {
	const float e = 0.01;
	vec3 dx = vec3(e, 0, 0), dy = vec3(0, e, 0), dz = vec3(0, 0, e);
	vec3 px0 = potential(p - dx), px1 = potential(p + dx);
	vec3 py0 = potential(p - dy), py1 = potential(p + dy);
	vec3 pz0 = potential(p - dz), pz1 = potential(p + dz);
	return vec3((py1.z - py0.z) - (pz1.y - pz0.y),
	            (pz1.x - pz0.x) - (px1.z - px0.z),
	            (px1.y - px0.y) - (py1.x - py0.x)) / (2.0 * e);
}

void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= uint(dust.length())) return;
	vec4 pa = dust[i].posAge;
	vec4 vl = dust[i].velLife;
	if (vl.w <= 0.0) return;	// 空き

	// 寿命
	pa.w += dt;
	if (pa.w >= vl.w) { dust[i].velLife = vec4(0.0); return; }

	float nl = max(length(floorNormal), 1e-6);
	vec3 n = floorNormal / nl;

	// 目標の速度へ近づける (空気抵抗)
	vec3 target = -n * sinkSpeed + turbulence * curlNoise(pa.xyz);
	vl.xyz = target + (vl.xyz - target) * exp(-drag * dt);
	pa.xyz += vl.xyz * dt;

	// 床より下に入ったら床の上に戻し、床へ向かう速度を消す
	float height = dot(floorNormal, pa.xyz) / nl - floorHeight / nl;
	if (height < 0.0) {
		pa.xyz -= n * height;
		float vn = dot(vl.xyz, n);
		if (vn < 0.0) vl.xyz -= n * vn;
	}

	dust[i].posAge = pa;
	dust[i].velLife = vl;
}
