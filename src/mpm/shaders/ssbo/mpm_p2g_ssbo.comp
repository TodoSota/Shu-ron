#version 430 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

uniform int u_gridSize;

// SSBO用の格子データ構造
struct GridNode {
	uint x;
	uint y;
	uint z;
	uint m;
};

layout(std430, binding = 2) buffer GridBuffer {
	GridNode grid[];
};

// 粒子のデータ構造
struct mpmParticle {
	vec4 position;
	vec4 velocity;
	mat4 affineC;
	mat4 deformation;
	float alpha;
	float q;
	float vc;
	int state;
	int scale;
	int padding[3];
};

layout(std430, binding = 0) readonly buffer mpmBuffer { mpmParticle p[]; };

// MPMの物理パラメータ
layout(std140, binding = 1) uniform MPMPhysics {
	vec3 gravity; float timestep;
	vec3 f_normal; float f_height;
	float f_restitution; float f_friction;
	float dx; float inv_dx;
	float p_restitution; float p_vol;
	float p_mu; float p_lambda;
	float p_mass; float p_radius;
	float p_overlap; float p_padding;
	vec4 obstacle_sphere; vec4 obstacle_velocity;
};

// --- アトミック加算関数 ---
// 座標でなく計算済みの1次元インデックス(idx)を用い無駄な再計算を省く
void atomicAddFloatX(uint idx, float val) {
    uint oldVal = grid[idx].x;
    uint newVal, expectedVal;
    do {
        expectedVal = oldVal;
        newVal = floatBitsToUint(uintBitsToFloat(expectedVal) + val);
        oldVal = atomicCompSwap(grid[idx].x, expectedVal, newVal);
    } while (oldVal != expectedVal);
}
void atomicAddFloatY(uint idx, float val) {
    uint oldVal = grid[idx].y;
    uint newVal, expectedVal;
    do {
        expectedVal = oldVal;
        newVal = floatBitsToUint(uintBitsToFloat(expectedVal) + val);
        oldVal = atomicCompSwap(grid[idx].y, expectedVal, newVal);
    } while (oldVal != expectedVal);
}
void atomicAddFloatZ(uint idx, float val) {
    uint oldVal = grid[idx].z;
    uint newVal, expectedVal;
    do {
        expectedVal = oldVal;
        newVal = floatBitsToUint(uintBitsToFloat(expectedVal) + val);
        oldVal = atomicCompSwap(grid[idx].z, expectedVal, newVal);
    } while (oldVal != expectedVal);
}
void atomicAddFloatM(uint idx, float val) { // gridIMA に対応
    uint oldVal = grid[idx].m;
    uint newVal, expectedVal;
    do {
        expectedVal = oldVal;
        newVal = floatBitsToUint(uintBitsToFloat(expectedVal) + val);
        oldVal = atomicCompSwap(grid[idx].m, expectedVal, newVal);
    } while (oldVal != expectedVal);
}

// 固有値分解・特異値分解
void jacobiEigen(inout mat3 S, out mat3 V) {
    V = mat3(1.0);
    for (int iter = 0; iter < 3; ++iter) {
        for (int p = 0; p < 2; ++p)
        for (int q = p + 1; q < 3; ++q) {
            float app = S[p][p]; float aqq = S[q][q]; float apq = S[p][q];
            if (abs(apq) < 1e-6) continue;
            float phi = 0.5 * atan(2.0 * apq, aqq - app);
            float c = cos(phi); float s = sin(phi);
            mat3 J = mat3(1.0);
            J[p][p] = c; J[p][q] = s; J[q][p] = -s; J[q][q] = c;
            S = transpose(J) * S * J; V = V * J;
        }
    }
}

void svd(mat3 F, out mat3 U, out mat3 Sigma, out mat3 V) {
    mat3 S = transpose(F) * F;
    jacobiEigen(S, V);
    Sigma = mat3(0.0);
    Sigma[0][0] = sqrt(max(S[0][0], 1e-4));
    Sigma[1][1] = sqrt(max(S[1][1], 1e-4));
    Sigma[2][2] = sqrt(max(S[2][2], 1e-4));
    mat3 invSigma = mat3(0.0);
    invSigma[0][0] = 1.0 / Sigma[0][0];
    invSigma[1][1] = 1.0 / Sigma[1][1];
    invSigma[2][2] = 1.0 / Sigma[2][2];
    U = F * V * invSigma;
}


void main() {
	uint p_idx = gl_GlobalInvocationID.x;
	if (p_idx >= uint(p.length())) return;

	vec3 x_pos = p[p_idx].position.xyz;
	vec3 v = p[p_idx].velocity.xyz;
	mat3 F = mat3(p[p_idx].deformation);
	mat3 C = mat3(p[p_idx].affineC);

	vec3 fx = x_pos * inv_dx;
	ivec3 base = ivec3(floor(fx - 0.5));
	vec3 weight_dist = fx - vec3(base);

	vec3 w[3];
	w[0] = 0.5 * pow( 1.5 - weight_dist, vec3(2.0));
	w[1] = 0.75 - pow( weight_dist - 1.0, vec3(2.0));
	w[2] = 0.5 * pow( weight_dist - 0.5, vec3(2.0));

	mat3 U, sig, V;
	svd(F, U, sig, V);

	mat3 e = mat3(0.0);
	e[0][0] = log( max(sig[0][0], 1e-6) );
	e[1][1] = log( max(sig[1][1], 1e-6) );
	e[2][2] = log( max(sig[2][2], 1e-6) );
	float trace_e = e[0][0] + e[1][1] + e[2][2];

	mat3 stress_diag = 2.0 * p_mu * e + p_lambda * trace_e * mat3(1.0);
	mat3 stress = U * stress_diag * transpose(V);
	stress = (-p_vol * 4.0 * inv_dx * inv_dx) * stress * transpose(F);

	mat3 affine = p_mass * C;
	
	// 最もループ回数が多く負荷になる処理
	for (int i=0; i<3; i++) {
		for (int j=0; j<3; j++) {
			for (int k=0; k<3; k++) {
				ivec3 node_coords = base + ivec3(i, j, k);
				
				// uint キャストによる最速の境界判定（マイナス値および上限オーバーを弾く）
				if (uint(node_coords.x) >= uint(u_gridSize) || 
				    uint(node_coords.y) >= uint(u_gridSize) || 
				    uint(node_coords.z) >= uint(u_gridSize)) {
					continue;
				}
				
				// 1次元インデックスの計算をループ内で1回だけ行う
				uint g_idx = uint(node_coords.x) + uint(u_gridSize) * (uint(node_coords.y) + uint(u_gridSize) * uint(node_coords.z));
				
				vec3 dpos = (vec3(i, j, k) - weight_dist) * dx;
				float weight = w[i].x * w[j].y * w[k].z;

				vec3 mom_contrib = weight * (p_mass * v + affine * dpos);
				vec3 force_contrib = weight * (stress * dpos);
				vec3 total_mom = mom_contrib + timestep * force_contrib;

				// 計算済みのインデックスを渡してアトミック加算
				atomicAddFloatX(g_idx, total_mom.x);
                atomicAddFloatY(g_idx, total_mom.y);
                atomicAddFloatZ(g_idx, total_mom.z);
                atomicAddFloatM(g_idx, weight * p_mass);
			}
		}
	}
}