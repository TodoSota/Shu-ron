#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

uniform int u_gridSize;

// グリッドの物質量
struct GridNode {
	uint x;
	uint y;
	uint z;
	uint m;
};

// SSBOバインディング (C++側で binding = 2 として設定)
layout(std430, binding = 2) writeonly buffer GridBuffer {
	GridNode grid[];
};

void main() {
	ivec3 coords = ivec3(gl_GlobalInvocationID.xyz);

	// 範囲外チェック
	// 負数は巨大な正数になる
	if (uint(coords.x) >= uint(u_gridSize) || uint(coords.y) >= uint(u_gridSize) || uint(coords.z) >= uint(u_gridSize)) {
		return;
	}

	// フラットインデックス計算 (積和演算で)
	uint idx = uint(coords.x) + uint(u_gridSize) * (uint(coords.y) + uint(u_gridSize) * uint(coords.z));

	// 0初期化
	grid[idx].x = 0u;
	grid[idx].y = 0u;
	grid[idx].z = 0u;
	grid[idx].m = 0u;
}