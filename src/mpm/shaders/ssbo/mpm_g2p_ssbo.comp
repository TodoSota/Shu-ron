#version 430 core

// 1グループ 64スレッド
layout(local_size_x = 64) in;

uniform int u_gridSize;

// SSBO用の格子データ構造
struct GridNode {
	uint x;
	uint y;
	uint z;
	uint m;
};

// SSBOバインディング (読み込み専用としてバインド)
layout(std430, binding = 2) readonly buffer GridBuffer {
	GridNode grid[];
};

// 粒子のデータ構造 (既存コードと完全同一)
struct mpmParticle {
	vec4 position;
	vec4 velocity;
	mat4 affineC;
	mat4 deformation;
	float alpha;
	float q;
	float vc;
	int state;
	int scale;
	int padding[3];
};

layout(std430, binding = 0) readonly buffer ParticleIn { mpmParticle particleIn[]; };
layout(std430, binding = 1) writeonly buffer ParticleOut { mpmParticle particleOut[]; };

// MPMの粒子群の物理パラメータ (既存コードと完全同一)
layout(std140, binding = 1) uniform MPMPhysics {
	vec3 gravity; float timestep;
	vec3 f_normal; float f_height;
	float f_restitution; float f_friction;
	float dx; float inv_dx;
	float p_restitution; float p_vol;
	float p_mu; float p_lambda;
	float p_mass; float p_radius;
	float p_overlap; float p_padding;
	vec4 obstacle_sphere; 
};

// 固有値分解 (既存コードと完全同一)
void jacobiEigen(inout mat3 S, out mat3 V) {
    V = mat3(1.0);
    for (int iter = 0; iter < 3; ++iter) {
        for (int p = 0; p < 2; ++p)
        for (int q = p + 1; q < 3; ++q) {
            float app = S[p][p]; float aqq = S[q][q]; float apq = S[p][q];
            if (abs(apq) < 1e-6) continue;
            float phi = 0.5 * atan(2.0 * apq, aqq - app);
            float c = cos(phi); float s = sin(phi);
            mat3 J = mat3(1.0);
            J[p][p] = c; J[p][q] = s; J[q][p] = -s; J[q][q] = c;
            S = transpose(J) * S * J; V = V * J;
        }
    }
}

// 特異値分解 (既存コードと完全同一)
void svd(mat3 F, out mat3 U, out mat3 Sigma, out mat3 V) {
    mat3 S = transpose(F) * F;
    jacobiEigen(S, V);
    Sigma = mat3(0.0);
    Sigma[0][0] = sqrt(max(S[0][0], 1e-4));
    Sigma[1][1] = sqrt(max(S[1][1], 1e-4));
    Sigma[2][2] = sqrt(max(S[2][2], 1e-4));
    mat3 invSigma = mat3(0.0);
    invSigma[0][0] = 1.0 / Sigma[0][0];
    invSigma[1][1] = 1.0 / Sigma[1][1];
    invSigma[2][2] = 1.0 / Sigma[2][2];
    U = F * V * invSigma;
}

void main() {
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= uint(particleIn.length())) return;

	// 明示的に更新しない分も含めて結果を先にコピー
	particleOut[idx] = particleIn[idx];

	// 1. 座標と重みの計算
	vec3 x = particleIn[idx].position.xyz;
	vec3 fx = x * inv_dx;
	ivec3 base = ivec3(floor(fx - 0.5));
	vec3 weight_dist = fx - vec3(base);

	// 2次Bスプライン補間
	vec3 w[3];
	w[0] = 0.5 * pow( 1.5 - weight_dist, vec3(2.0));
	w[1] = 0.75 - pow( weight_dist - 1.0, vec3(2.0));
	w[2] = 0.5 * pow( weight_dist - 0.5, vec3(2.0));

	// 2. グリッドからの速度・アフィン行列の回収
	vec3 new_v = vec3(0.0);
	mat3 new_C = mat3(0.0);

	for (int i = 0; i < 3; i++) {
		for (int j = 0; j < 3; j++) {
			for (int k = 0; k < 3; k++) {
				ivec3 coords = base + ivec3(i, j, k);
				
				// 最速の境界判定 (uintキャスト)
				if (uint(coords.x) >= uint(u_gridSize) || 
				    uint(coords.y) >= uint(u_gridSize) || 
				    uint(coords.z) >= uint(u_gridSize)) {
					continue;
				}
				
				// 1次元インデックス計算
				uint g_idx = uint(coords.x) + uint(u_gridSize) * (uint(coords.y) + uint(u_gridSize) * uint(coords.z));
				
				float weight = w[i].x * w[j].y * w[k].z;

				// グリッドデータの読み込み (SSBO配列アクセス)
				float m = uintBitsToFloat(grid[g_idx].m);
				if (m < 1e-7) continue;

				vec3 g_v = vec3(
					uintBitsToFloat(grid[g_idx].x),
					uintBitsToFloat(grid[g_idx].y),
					uintBitsToFloat(grid[g_idx].z)
				) / m;

				vec3 dpos = (vec3(i, j, k) - weight_dist) * dx;
				new_v += weight * g_v;
				new_C += 4.0 * inv_dx * weight * outerProduct(g_v, dpos);
			}
		}
	}

	// 3. 変形勾配 F の更新
	mat3 F_new = (mat3(1.0) + timestep * new_C) * mat3(particleIn[idx].deformation);

	// 4. 塑性変形
	mat3 U, sig, V;
	svd(F_new, U, sig, V);

	float epsilon[3];
	epsilon[0] = log(max(sig[0][0], 1e-6));
	epsilon[1] = log(max(sig[1][1], 1e-6));
	epsilon[2] = log(max(sig[2][2], 1e-6));

	float tr_e = epsilon[0] + epsilon[1] + epsilon[2] + particleIn[idx].vc;
	vec3 e_hat = vec3(epsilon[0], epsilon[1], epsilon[2]) - tr_e / 3.0;
	float e_hat_norm = length(e_hat);

	float delta_gamma = e_hat_norm + (3.0 * p_lambda + 2.0 * p_mu) / (2.0 * p_mu) * tr_e * particleIn[idx].alpha;

	vec3 new_epsilon;
	vec3 epsilon_v = vec3(epsilon[0], epsilon[1], epsilon[2]);

	int next_state = 0;
	if (e_hat_norm < 1e-8 || tr_e > 0.0) {
		new_epsilon = vec3(0.0);
	} else if (delta_gamma <= 0.0) {
		new_epsilon = epsilon_v;
		next_state = 1;
	} else {
		new_epsilon = epsilon_v - (delta_gamma / e_hat_norm) * e_hat;
		next_state = 2;
	}

	// 5. 硬化
	float delta_q = 0.0;
	if (next_state == 0) {
		delta_q = length(epsilon_v);
	} else if (next_state == 2) {
		delta_q = delta_gamma;
	}

	delta_q = delta_q + particleIn[idx].q;
	float phi = 35.0 + (9.0 * delta_q - 3.0) * exp(-0.2 * delta_q);
	phi = radians(phi);

	mat3 sig_new = mat3(0.0);
	sig_new[0][0] = exp(new_epsilon.x);
	sig_new[1][1] = exp(new_epsilon.y);
	sig_new[2][2] = exp(new_epsilon.z);

	mat3 F_after = U * sig_new * transpose(V);
	float det_before = determinant(F_new);
	float det_after = determinant(F_after);

	particleOut[idx].state = next_state;
	particleOut[idx].q = delta_q;
	particleOut[idx].alpha = sqrt(2.0/3.0) * (2.0 * sin(phi)) / (3.0 - sin(phi));
	particleOut[idx].vc = particleIn[idx].vc - log(max(det_after, 1e-6)) + log(max(det_before, 1e-6));
	particleOut[idx].position.xyz += new_v * timestep;
	particleOut[idx].deformation = mat4(F_after);
	particleOut[idx].velocity = vec4(new_v, 0);
	particleOut[idx].affineC = mat4(new_C);
}