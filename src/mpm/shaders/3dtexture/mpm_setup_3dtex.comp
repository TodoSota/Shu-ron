#version 430 core

//==============================================================================
// mpm_setup.comp : 格子のクリア
// 目的: 毎ステップの P2G の前に、格子の運動量 X/Y/Z と質量 A をすべて 0 に戻す。
//       P2G は atomic に「加算」するため、前ステップの値が残っていると結果が壊れる。
// 並列化: 1 スレッド = 1 格子点 (8×8×8 のグループで格子全体を覆う)
//==============================================================================

// グリッドの3次元的にリセットするため 8*8*8 に立方体スレッドで
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// 3Dテクスチャ
layout(r32ui, binding = 0) uniform writeonly uimage3D gridIMX;	// 運動量 X
layout(r32ui, binding = 1) uniform writeonly uimage3D gridIMY;	// 運動量 Y
layout(r32ui, binding = 2) uniform writeonly uimage3D gridIMZ;	// 運動量 Z
layout(r32ui, binding = 3) uniform writeonly uimage3D gridIMM;	// 質量 M

void main() {
	// スレッドの担当グリッド座標  (x, y, z)
	ivec3 coords = ivec3(gl_GlobalInvocationID.xyz);

	// テクスチャサイズ
	ivec3 size = imageSize(gridIMX);

	// 範囲外アクセス防止
	if (coords.x >= size.x || coords.y >= size.y || coords.z >= size.z) {
		return;
	}

	// ゼロはビット表現でもゼロなのでそのままで
	uint zero = 0u;

	// グリッドを 0で初期化 (運動量, 質量 : 0)
	imageStore(gridIMX, coords, uvec4(zero));
	imageStore(gridIMY, coords, uvec4(zero));
	imageStore(gridIMZ, coords, uvec4(zero));
	imageStore(gridIMM, coords, uvec4(zero));
}