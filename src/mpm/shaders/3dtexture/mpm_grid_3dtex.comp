#version 430 core

//==============================================================================
// mpm_grid.comp : Grid (格子) 更新ステップ
//
// 目的:
//   P2G で集めた格子点ごとの「運動量 (力積込み)」と「質量」から格子点の速度を求め、
//     ・重力 (外力) の適用
//     ・床 (無限平面) との境界条件: 法線方向の侵入を止め、Coulomb 摩擦を適用
//     ・SDF で表した剛体障害物との境界条件: 障害物の速度に対する相対速度で
//       同じく侵入を止め、Coulomb 摩擦を適用 (一方向連成: 砂は剛体を押し返さない)
//   を行い、結果を「運動量」の形で格子に書き戻す。
//
//   MPM では境界条件を粒子ではなく格子の速度に課すのが基本であり、
//   この段階が衝突処理の本体になる。
//
// 並列化の方針: 1 スレッド = 1 格子点。8×8×8 のグループで格子全体を覆う。
//   各スレッドは自分の格子点だけを読み書きするので atomic 操作は不要。
//==============================================================================

// 8*8*8 のスレッドグループでグリッド全体を走査
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// テクスチャ 4枚
layout(r32ui, binding = 0) uniform uimage3D gridIMX;
layout(r32ui, binding = 1) uniform uimage3D gridIMY;
layout(r32ui, binding = 2) uniform uimage3D gridIMZ;
layout(r32ui, binding = 3) uniform uimage3D gridIMA;
// SDF テクスチャ 1枚
//   障害物メッシュのローカル空間 (AABB に余白を加えた範囲) で、符号付き距離を R32F で格納したもの。
//   線形補間でサンプリングする (MeshResource::generateSDF で生成)
layout(binding = 4) uniform sampler3D sdf_tex;

// MPMの粒子群の物理パラメータ
layout(std140, binding = 1) uniform MPMPhysics {
	// シミュレーション空間
	vec3 gravity;		// 重力
	float timestep;		// 時間間隔
	vec3 f_normal;		// 地面の法線
	float f_height;		// 地面の高さ
	
	float f_restitution;// 地面の反発係数
	float f_friction;	// 地面の摩擦係数
	float dx;			// グリッドの間隔
	float inv_dx;		// 間隔の逆数

	// 粒子
	float p_restitution;// 粒子の反発係数
	float p_vol;		// 粒子の体積
	float p_mu;			// 粒子のラメ係数
	float p_lambda;		// 粒子のラメ係数

	float p_mass;		// 粒子の質量
	float p_radius;		// 粒子の半径
	float p_overlap;	// 粒子の重なり
	float p_padding;	// 調整

	// 障害物
	vec4 obstacle_sphere; // 静的物体の仮説
	vec4 obstacle_velocity; // 静的物体の仮説
};

// ビット変換用のヘルパー関数
float uintToFloat(uint val) { return uintBitsToFloat(val); }
uint floatToUint(float val) { return floatBitsToUint(val); }

// SDF のユニフォーム変数 (障害物 1 個分の姿勢と速度。MpmSimulator::step で毎ステップ設定)
uniform mat4 sdf_model;
uniform mat4 sdf_inv_model;
uniform vec3 sdf_velocity;
uniform vec3 sdf_aabb_min;
uniform vec3 sdf_aabb_max;
uniform vec3 sdf_angular_velocity; // 角速度
uniform vec3 sdf_center;           // オブジェクトの回転中心（重心）座標

void main() {
	ivec3 coords = ivec3(gl_GlobalInvocationID.xyz);
	ivec3 size = imageSize(gridIMX);

	// 範囲外アクセス防止 (格子サイズが 8 の倍数でない場合の端数スレッド)
    if (coords.x >= size.x || coords.y >= size.y || coords.z >= size.z) return;

	// 1. グリッドデータ読み込み
	float m = uintToFloat(imageLoad(gridIMA, coords).x);
	if (m <= 1e-7) return;	// 質量がほぼゼロなら処理スキップ

	vec3 v = vec3(
        uintToFloat(imageLoad(gridIMX, coords).x),
        uintToFloat(imageLoad(gridIMY, coords).x),
        uintToFloat(imageLoad(gridIMZ, coords).x)
    );

	// 2. 速度算出と外力(重力含む)の適用
	v /= m;						// 運動量を質量で割る
	v += gravity * timestep;	// 重力を適用

	// 3. 境界条件・当たり判定
	// [点検] P2G / G2P では格子点 i の位置を i·dx として重みを計算しているが、
	//   ここでは (i + 0.5)·dx (セル中心) としているため、境界判定の位置が半セル
	//   ずれる (床が実質 0.5dx 低い、SDF が 0.5dx ずれる)。
	//   P2G / G2P と揃えるなら pos = vec3(coords) * dx にする。
	//   また、床以外の領域の端 (6 面) には壁の条件が無い。領域外へ出た粒子は格子に
	//   寄与できなくなる。
	vec3 pos = (vec3(coords) + vec3(0.5)) * dx;	// 現在のセルの世界座標の計算

	float dist = dot(pos, f_normal) - f_height;	// 床との判定・グリッドでの判定なので、ノードが床を貫通しているのかを見ている

	// 床より下なら
	if (dist < 0.0) {
		float v_normal = dot(v, f_normal); // 法線方向の成分を取得

		// 下向きに落下してるなら (床から離れる向きの速度は拘束しない = separating 境界)
		if (v_normal < 0.0) {
			vec3 vn = f_normal * v_normal;	// 法線方向の速度
			vec3 vt = v - vn;				// 接線方向の速度

			// 摩擦 (Coulomb): 法線方向に止めた速度 |v_n| に比例して接線速度を減らし、
			// 減らしきれる場合は 0 にする (静止摩擦)
			float vt_len = length(vt);
			if(vt_len > 1e-7){
				float friction_factor = max(0.0, 1.0 - f_friction * abs(v_normal) / vt_len);
				vt *= friction_factor;
			}

			// 速度の更新
			//   法線成分を -e·v_n で反転させている (反発係数 e)。
			//   ※ 連続体としての MPM では、格子の境界条件は v_n = 0 (非弾性) とするのが普通で、
			//     格子速度を反発させると、境界付近の粒子が跳ねたり振動したりする原因になりうる。
			v = vt - f_restitution * vn;
		}
	}


	//
	// 動的物体やその他当たり判定を行うならここ
	// 摩擦の部分は使いまわせるかもなので、必要ならヘルパー関数にする
	// SDF を使うなら、こちらでも dist を作成して判定できるハズ
	//

	// SDF を追加するための判定ロジック部分
	// 1. 現在のグリッドノードのワールド座標を計算 
	// ※ 追加分

	// 2. ワールド座標 -> SDFローカル座標への逆変換 (障害物の平行移動・回転・拡大を打ち消す)
	vec4 pos_local_vec4 = sdf_inv_model * vec4(pos, 1.0);
	vec3 pos_local = pos_local_vec4.xyz;

	// 3. ローカル座標がAABBの中に入っているかチェック（最適化：外なら計算しない）
	if (all(greaterThanEqual(pos_local, sdf_aabb_min)) && all(lessThanEqual(pos_local, sdf_aabb_max))) {
    
		// 4. ローカル座標 -> テクスチャUVW座標 (0.0 ~ 1.0) へのマッピング
		//   [点検] SDF のボクセル値は sdfMin + idx·cellSize (cellSize = 幅 / (res - 1)) の
		//   「格子点」で計算されているが、texture() はテクセル中心 (idx + 0.5) / res で
		//   補間する。正確に対応させるなら
		//   uvw = (pos_local - min) / (max - min) * (res - 1) / res + 0.5 / res とする
		//   (最大で半ボクセルずれる)。
		vec3 uvw = (pos_local - sdf_aabb_min) / (sdf_aabb_max - sdf_aabb_min);
    
		// 5. 距離のサンプリング
		float dist_local = texture(sdf_tex, uvw).r;
		// 等方前提なので注意！！！！
		// (sdf_model の第 1 列の長さ = x 方向の拡大率でローカル距離をワールド距離に換算している。
		//  Swing モードの (0.06, 0.4, 0.06) のような非等方スケールでは、距離の値が正しくない)
		float dist_world = dist_local * length(vec3(sdf_model[0]));// X軸スケールからスケールをかけてワールドでの距離に
    
		// 6. 衝突判定 (距離が粒子半径より小さければ接触しているとみなす)
		if (dist_world < p_radius) {
        
			// --- 法線(Normal)の計算 (中央差分) ---
			// テクスチャの1ピクセル分くらいずらしてサンプリングし、勾配を求める
			vec3 texSize = vec3(textureSize(sdf_tex, 0));	// テクスチャ解像度
			vec3 texel = 1.0 / texSize;						
			vec3 epsX = vec3(texel.x, 0.0, 0.0);
			vec3 epsY = vec3(0.0, texel.y, 0.0);
			vec3 epsZ = vec3(0.0, 0.0, texel.z);
        
			float nx = (texture(sdf_tex, uvw + epsX).r - texture(sdf_tex, uvw - epsX).r) / (2.0 * texel.x);
			float ny = (texture(sdf_tex, uvw + epsY).r - texture(sdf_tex, uvw - epsY).r) / (2.0 * texel.y);
			float nz = (texture(sdf_tex, uvw + epsZ).r - texture(sdf_tex, uvw - epsZ).r) / (2.0 * texel.z);
        
			// ローカル空間での法線
			//   [点検] 上の差分は uvw 空間での勾配である。AABB が立方体でない場合は、
			//   各成分をその軸の幅 (sdf_aabb_max - sdf_aabb_min) で割らないと、
			//   ローカル空間の法線の向きにならない。
			vec3 normal_local = normalize(vec3(nx, ny, nz));
        
			// 7. ローカル法線 -> ワールド法線への変換 (正行列の3x3部分を掛ける)
			// "法線行列はモデル行列の逆行列の転置" になる(らしい)
			vec3 normal_world = normalize(mat3(transpose(sdf_inv_model)) * normal_local);
        
			// 8. 衝突解決 (相対速度の押し出し)
			//   剛体上の点の速度 v_point = v_trans + ω × r を基準にした相対速度で、
			//   床と同じ「侵入成分を止めて Coulomb 摩擦を適用する」処理を行う。
			//   (ペナルティ力ではなく、速度を直接拘束する方式)
			vec3 r = pos - sdf_center;

			// v_point = v_trans + ω × r
			vec3 point_velocity = sdf_velocity + cross(sdf_angular_velocity, r);
			
			// grid_vel は現在のグリッドの速度(vec3)とします
			vec3 rel_vel = v - point_velocity;
			float vn = dot(rel_vel, normal_world);

			// 接触 + めり込み条件
			if (dist_world < p_radius && vn < 0.0) {

				vec3 vt = rel_vel - vn * normal_world;
				float vt_len = length(vt);

				float mu = f_friction;

				// 法線方向は止める
				vec3 new_rel_vel = vt;

				// 摩擦
				if (vt_len > 1e-6) {
					float max_friction = -mu * vn;

					if (vt_len < max_friction) {
						new_rel_vel = vec3(0.0);
					} else {
						new_rel_vel = vt * (1.0 - max_friction / vt_len);
					}
				}

				v = point_velocity + new_rel_vel;
			}
		}
	}

	// 4. 更新されたデータを戻す
	//   G2P は「運動量 / 質量」で速度を読むので、速度に質量を掛けて運動量の形で書き戻す
	// 質量は更新されていないので不要
	imageStore(gridIMX, coords, uvec4(floatToUint(v.x * m)));
    imageStore(gridIMY, coords, uvec4(floatToUint(v.y * m)));
    imageStore(gridIMZ, coords, uvec4(floatToUint(v.z * m)));
}
